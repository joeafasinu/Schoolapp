<div class="toolbar">
  <h2><%= subject.name %> — <%= klass.name %></h2>
  <span class="badge badge-gold"><%= term.term_name %>, <%= term.session_name %></span>
</div>

<div class="card">
  <p class="muted">Enter each component score, then click Save. Totals update automatically as you type. Max per component shown in the column header.</p>
  <form method="POST" action="/scores/<%= klass.id %>/<%= subject.id %>">
    <div style="overflow-x:auto;">
    <table id="score-table">
      <thead>
        <tr>
          <th>Student</th>
          <% components.forEach(c => { %><th><%= c.name %> <br/><span style="font-weight:400;font-size:0.75rem;">/ <%= c.max_score %></span></th><% }) %>
          <th>Total</th>
        </tr>
      </thead>
      <tbody>
      <% students.forEach(s => { %>
        <tr>
          <td><%= s.full_name %></td>
          <% components.forEach(c => { %>
            <td>
              <input
                type="number" step="0.5" min="0" max="<%= c.max_score %>"
                name="score_<%= s.id %>_<%= c.id %>"
                class="score-input"
                data-student="<%= s.id %>"
                value="<%= scoreMap[s.id + '_' + c.id] ?? '' %>"
              />
            </td>
          <% }) %>
          <td><strong><span class="row-total" data-student-total="<%= s.id %>">0</span></strong></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
    </div>
    <button class="btn btn-gold" type="submit" style="margin-top:1rem;">Save Scores</button>
  </form>
</div>

<script>
  function recalcRow(studentId) {
    const inputs = document.querySelectorAll('input.score-input[data-student="' + studentId + '"]');
    let total = 0;
    inputs.forEach(inp => { total += parseFloat(inp.value || 0); });
    const totalEl = document.querySelector('.row-total[data-student-total="' + studentId + '"]');
    if (totalEl) totalEl.textContent = total.toFixed(1);
  }
  document.querySelectorAll('input.score-input').forEach(inp => {
    inp.addEventListener('input', () => recalcRow(inp.dataset.student));
    recalcRow(inp.dataset.student);
  });
</script>
