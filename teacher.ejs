<h2>Welcome, <%= user.name %></h2>
<p class="muted">
  <% if (activeTerm) { %>Active term: <strong><%= activeTerm.term_name %>, <%= activeTerm.session_name %></strong><% } else { %>
    <span class="badge badge-red">No active term set</span> — ask your school admin to set one.
  <% } %>
</p>

<% if (formClass) { %>
<div class="card">
  <h3>Your Form Class: <%= formClass.name %></h3>
  <p class="muted">You're responsible for daily attendance for this class.</p>
  <a href="/attendance?class_id=<%= formClass.id %>" class="btn btn-gold">Mark Today's Attendance</a>
</div>
<% } %>

<div class="card">
  <h3>Your Subject Assignments</h3>
  <% if (assignments.length === 0) { %>
    <p class="muted">No subjects assigned to you yet. Ask your school admin to assign you.</p>
  <% } else { %>
    <table>
      <thead><tr><th>Class</th><th>Subject</th><th>Action</th></tr></thead>
      <tbody>
      <% assignments.forEach(a => { %>
        <tr>
          <td><%= a.class_name %></td>
          <td><%= a.subject_name %></td>
          <td><a class="btn btn-sm" href="/scores/<%= a.class_id %>/<%= a.subject_id %>">Enter Scores</a></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  <% } %>
</div>
