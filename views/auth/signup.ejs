<div class="auth-split">
  <div class="auth-visual">
    <div class="auth-visual-inner">
      <span class="brand-mark big">SA</span>
      <h1>Get your school running in minutes</h1>
      <p>Create your account, add your classes and subjects once, and start taking attendance and recording results.</p>
      <ul>
        <li>14-day free trial, no card needed</li>
        <li>Your own branded login page</li>
        <li>Bulk-import your students from a spreadsheet</li>
      </ul>
    </div>
    <div class="auth-visual-foot">SchoolApp</div>
  </div>
  <div class="auth-panel">
    <div class="auth-card">
      <h2>Register your school</h2>
      <p class="muted">Create your school's account in under a minute.</p>
      <% if (error) { %><div class="error-msg"><%= error %></div><% } %>
      <form method="POST" action="/signup">
        <div class="field">
          <label>School Name</label>
          <input type="text" name="school_name" placeholder="e.g. Brightfield Academy" required />
        </div>
        <div class="field">
          <label>Your Name (School Admin)</label>
          <input type="text" name="admin_name" required />
        </div>
        <div class="field">
          <label>Email</label>
          <input type="email" name="email" required />
        </div>
        <div class="field">
          <label>Password</label>
          <input type="password" name="password" required minlength="6" />
        </div>
        <button class="btn btn-gold" style="width:100%; padding:0.7rem;" type="submit">Create School Account</button>
      </form>
      <p style="margin-top:1.2rem; font-size:0.9rem;">Already have an account? <a href="/login">Log in</a></p>
    </div>
  </div>
</div>
