<div class="toolbar">
  <h2>Fee Structure</h2>
  <span class="badge badge-gold"><%= term.term_name %>, <%= term.session_name %></span>
</div>
<p class="muted">Set the expected fee amount (and optional due date) for each class, for this term. Balances are calculated automatically once this is set.</p>

<% if (saved) { %><div class="success-msg">Saved.</div><% } %>

<div class="card">
  <form method="POST" action="/fees/structure">
    <table>
      <thead><tr><th>Class</th><th>Fee Amount (₦)</th><th>Due Date</th></tr></thead>
      <tbody>
      <% classes.forEach(c => { %>
        <tr>
          <td><%= c.name %></td>
          <td><input type="number" step="0.01" min="0" name="amount_<%= c.id %>" value="<%= c.amount || '' %>" placeholder="0.00" /></td>
          <td><input type="date" name="due_date_<%= c.id %>" value="<%= c.due_date ? new Date(c.due_date).toISOString().slice(0,10) : '' %>" /></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
    <button class="btn btn-gold" type="submit" style="margin-top:1rem;">Save Fee Structure</button>
  </form>
</div>
