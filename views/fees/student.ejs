<div class="toolbar">
  <h2><%= student.full_name %> — Fees</h2>
  <span class="badge badge-gold"><%= term.term_name %>, <%= term.session_name %></span>
</div>

<% if (justPaid) { %>
  <div class="success-msg" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.6rem;">
    <span>
      Payment recorded! <%= summary.balance <= 0 ? "This student's fees are now fully paid." : `Balance remaining: ${formatNaira(summary.balance)}.` %>
    </span>
    <span>
      <a class="btn btn-sm btn-outline" href="/fees/student/<%= student.id %>/receipt/<%= justPaid %>">View Receipt</a>
      <a class="btn btn-sm btn-gold" href="/fees/student/<%= student.id %>/receipt/<%= justPaid %>/pdf">Download PDF</a>
      <% const waNum = toWhatsAppNumber(student.guardian_phone); %>
      <% const justPaidRecord = payments.find(p => p.id === Number(justPaid)); %>
      <% if (waNum) { %>
        <% const waMsg = `Hello ${student.guardian_name || 'Parent/Guardian'}, this confirms we received a payment of ${formatNaira(justPaidRecord ? justPaidRecord.amount : 0)} for ${student.full_name}'s school fees (${term.term_name}, ${term.session_name}). Total paid so far: ${formatNaira(summary.paid)}. Balance remaining: ${formatNaira(summary.balance)}. Thank you!`; %>
        <a class="btn btn-sm" style="background:#25D366;" target="_blank" rel="noopener"
           href="https://wa.me/<%= waNum %>?text=<%= encodeURIComponent(waMsg) %>">
          Send via WhatsApp
        </a>
      <% } else { %>
        <span class="muted" style="font-size:0.8rem;">(No guardian phone on file to send a WhatsApp receipt)</span>
      <% } %>
    </span>
  </div>
<% } %>

<div class="card-grid" style="margin-bottom:1rem;">
  <div class="card stat-box"><div class="stat-num"><%= formatNaira(summary.expected) %></div><div class="stat-label">Term Fee</div></div>
  <div class="card stat-box"><div class="stat-num" style="color:var(--green);"><%= formatNaira(summary.paid) %></div><div class="stat-label">Paid So Far</div></div>
  <div class="card stat-box"><div class="stat-num" style="color:<%= summary.balance > 0 ? 'var(--red)' : 'var(--green)' %>;"><%= formatNaira(summary.balance) %></div><div class="stat-label">Balance</div></div>
  <div class="card stat-box">
    <div class="stat-num">
      <% if (summary.status === 'Paid') { %><span class="badge badge-green">Paid</span>
      <% } else if (summary.status === 'Partial') { %><span class="badge badge-gold">Partial</span>
      <% } else if (summary.status === 'No Fee Set') { %><span class="badge muted">No Fee Set</span>
      <% } else { %><span class="badge badge-red">Unpaid</span><% } %>
    </div>
    <div class="stat-label">Status<% if (summary.overdue) { %> — <span style="color:var(--red);">Overdue</span><% } %></div>
  </div>
</div>

<div class="card" style="max-width:480px;">
  <h3>Record a Payment</h3>
  <% if (summary.expected === 0) { %>
    <p class="muted">No fee amount has been set for this student's class yet. <a href="/fees/structure">Set it up here</a> first.</p>
  <% } %>
  <form method="POST" action="/fees/student/<%= student.id %>/payment">
    <div class="form-row">
      <div class="field">
        <label>Amount Paid (₦)</label>
        <input type="number" step="0.01" min="0.01" name="amount" required />
      </div>
      <div class="field">
        <label>Date</label>
        <input type="date" name="payment_date" value="<%= new Date().toISOString().slice(0,10) %>" />
      </div>
    </div>
    <div class="form-row">
      <div class="field">
        <label>Method</label>
        <select name="method">
          <option value="cash">Cash</option>
          <option value="bank transfer">Bank Transfer</option>
          <option value="pos">POS</option>
          <option value="other">Other</option>
        </select>
      </div>
      <div class="field">
        <label>Notes (optional)</label>
        <input type="text" name="notes" placeholder="e.g. part payment, ref no." />
      </div>
    </div>
    <button class="btn btn-gold" type="submit">Save Payment</button>
  </form>
</div>

<div class="card">
  <h3>Payment History</h3>
  <% if (payments.length === 0) { %>
    <p class="muted">No payments recorded yet.</p>
  <% } else { %>
    <table>
      <thead><tr><th>Date</th><th>Amount</th><th>Method</th><th>Notes</th><th>Receipt</th></tr></thead>
      <tbody>
      <% payments.forEach(p => { %>
        <tr>
          <td><%= new Date(p.payment_date).toLocaleDateString() %></td>
          <td><%= formatNaira(p.amount) %></td>
          <td><%= p.method || '—' %></td>
          <td><%= p.notes || '—' %></td>
          <td><a class="btn btn-sm btn-outline" href="/fees/student/<%= student.id %>/receipt/<%= p.id %>">View</a></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  <% } %>
</div>
