<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title + ' · SchoolApp' : 'SchoolApp' %></title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <% if (user) { %>
  <%
    const menus = [];
    if (user.role === 'school_admin') {
      menus.push({ label: 'Academics', items: [
        ['Levels & Classes', '/setup/levels'], ['Classes', '/setup/classes'], ['Subjects', '/setup/subjects'], ['Terms', '/setup/terms'] ] });
      menus.push({ label: 'People', items: [
        ['Students', '/setup/students'], ['Bulk Import Students', '/setup/students/import'], ['Teachers', '/setup/teachers'], ['Bursars', '/setup/bursars'] ] });
      menus.push({ label: 'Grading', items: [
        ['Components & Weights', '/setup/components'], ['Grading Scale & Comments', '/setup/grading-scale'], ['Report Card Sections', '/setup/traits'] ] });
      menus.push({ label: 'Results', items: [
        ['Broadsheet', '/broadsheet'], ['Attendance Summary', '/attendance/summary'], ['Report Card Ratings', '/traits'] ] });
      menus.push({ label: 'Finance', items: [ ['Fee Structure', '/fees/structure'] ] });
      menus.push({ label: 'Settings', items: [ ['Branding & Login Page', '/setup/branding'], ['Billing', '/billing'] ] });
    } else if (user.role === 'teacher') {
      menus.push({ label: 'Enter Scores', href: '/scores' });
      menus.push({ label: 'Attendance', href: '/attendance' });
      menus.push({ label: 'Report Ratings', href: '/traits' });
    } else if (user.role === 'bursar') {
      menus.push({ label: 'Fee Dashboard', href: '/dashboard' });
      menus.push({ label: 'Fee Structure', href: '/fees/structure' });
    } else if (user.role === 'platform_admin') {
      menus.push({ label: 'Schools', href: '/platform' });
    }
  %>
  <header class="topbar no-print">
    <a class="topbar-brand" href="/dashboard">
      <% if (user.school_id) { %>
        <img src="/branding/logo/<%= user.school_id %>" alt="" class="topbar-logo" onerror="this.style.display='none'; document.getElementById('brand-mark-fallback').style.display='inline-block';" />
        <span class="brand-mark" id="brand-mark-fallback" style="display:none;">SA</span>
      <% } else { %>
        <span class="brand-mark">SA</span>
      <% } %>
      SchoolApp
      <% if (user.school_name) { %><span class="school-tag"><%= user.school_name %></span><% } %>
    </a>
    <button class="nav-toggle" type="button" aria-label="Toggle menu">&#9776;</button>
    <nav class="topbar-nav" id="topbar-nav">
      <a href="/dashboard">Dashboard</a>
      <% menus.forEach(m => { %>
        <% if (m.href) { %>
          <a href="<%= m.href %>"><%= m.label %></a>
        <% } else { %>
          <div class="dropdown">
            <button type="button" class="dropdown-toggle"><%= m.label %> &#9662;</button>
            <div class="dropdown-menu">
              <% m.items.forEach(i => { %><a href="<%= i[1] %>"><%= i[0] %></a><% }) %>
            </div>
          </div>
        <% } %>
      <% }) %>
      <div class="dropdown dropdown-right">
        <button type="button" class="dropdown-toggle"><span class="avatar"><%= user.name.charAt(0).toUpperCase() %></span><%= user.name.split(' ')[0] %> &#9662;</button>
        <div class="dropdown-menu">
          <div class="dropdown-meta"><%= user.name %><br /><small><%= user.role.replace('_', ' ') %></small></div>
          <% if (user.role !== 'platform_admin') { %><a href="/billing">Billing</a><% } %>
          <a href="/logout">Log out</a>
        </div>
      </div>
    </nav>
  </header>
  <main class="page-wrap">
    <%- body %>
  </main>
  <script>
    (function () {
      var nav = document.getElementById('topbar-nav');
      var burger = document.querySelector('.nav-toggle');
      if (burger) burger.addEventListener('click', function () { nav.classList.toggle('open'); });
      function closeAll() { document.querySelectorAll('.dropdown.open').forEach(function (d) { d.classList.remove('open'); }); }
      document.querySelectorAll('.dropdown-toggle').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
          e.stopPropagation();
          var dd = btn.parentElement, wasOpen = dd.classList.contains('open');
          closeAll();
          if (!wasOpen) dd.classList.add('open');
        });
      });
      document.addEventListener('click', closeAll);
    })();
  </script>
  <% } else { %>
    <%- body %>
  <% } %>
</body>
</html>
