<div class="toolbar">
  <h2>Classes</h2>
  <a href="/setup/levels" class="btn btn-outline btn-sm">Manage via Levels &amp; Classes →</a>
</div>
<p class="muted">Tip: if your classes are grouped into levels (Nursery, Primary, JSS, SSS), it's usually easier to add sub-classes and their subjects from <a href="/setup/levels">Levels &amp; Classes</a> — subjects get assigned automatically there instead of one class at a time.</p>

<% if (error) { %><div class="error-msg"><%= error %></div><% } %>

<div class="card">
  <h3>Add a standalone class</h3>
  <form method="POST" action="/setup/classes" class="form-row">
    <div class="field">
      <label>Class Name</label>
      <input type="text" name="name" placeholder="e.g. JSS 1A" required />
    </div>
    <div class="field">
      <label>Level (optional)</label>
      <select name="level_id">
        <option value="">— None (standalone) —</option>
        <% levels.forEach(l => { %><option value="<%= l.id %>"><%= l.name %></option><% }) %>
      </select>
    </div>
    <div class="field">
      <label>Form Teacher (optional)</label>
      <select name="form_teacher_id">
        <option value="">— None —</option>
        <% teachers.forEach(t => { %><option value="<%= t.id %>"><%= t.name %></option><% }) %>
      </select>
    </div>
    <div class="field" style="flex:0; align-self:flex-end;">
      <button class="btn" type="submit">Add Class</button>
    </div>
  </form>
</div>

<div class="card">
  <table>
    <thead><tr><th>Class</th><th>Level</th><th>Form Teacher</th><th>Students</th><th>Actions</th></tr></thead>
    <tbody>
    <% classes.forEach(c => { %>
      <tr>
        <td><%= c.name %></td>
        <td><%= c.level_name ? c.level_name : '—' %></td>
        <td><%= c.teacher_name || '—' %></td>
        <td><%= c.student_count %></td>
        <td>
          <a class="btn btn-sm btn-outline" href="/broadsheet/<%= c.id %>">Broadsheet</a>
          <form method="POST" action="/setup/classes/<%= c.id %>?_method=DELETE" style="display:inline" onsubmit="return confirm('Delete this class?')">
            <button class="btn btn-sm btn-danger" type="submit">Delete</button>
          </form>
        </td>
      </tr>
    <% }) %>
    </tbody>
  </table>
</div>
