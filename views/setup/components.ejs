<div class="toolbar"><h2>Grading Components</h2></div>
<p class="muted">These are the pieces that make up a subject's total score — e.g. CA1, CA2, Exam. Add a component here (like "Note Taking" or "Assignment") and it will appear as a column for every teacher entering scores.</p>

<% if (error) { %><div class="error-msg"><%= error %></div><% } %>
<% if (weightGroups.length === 0 && total !== 100) { %>
  <div class="error-msg">Heads up: your components currently add up to <strong><%= total %></strong>, not 100. Scores will still total correctly, but you may want your components to sum to 100 for clean percentages — or use Weight Groups below for more control.</div>
<% } %>

<div class="card" style="max-width:600px;">
  <h3>Add a Component</h3>
  <form method="POST" action="/setup/components" class="form-row">
    <div class="field">
      <label>Name</label>
      <input type="text" name="name" placeholder="e.g. Note Taking" required />
    </div>
    <div class="field">
      <label>Max Score</label>
      <input type="number" step="0.5" min="1" name="max_score" placeholder="10" required />
    </div>
    <div class="field">
      <label>Group (optional)</label>
      <input type="text" name="group_name" placeholder="e.g. CA" />
    </div>
    <div class="field" style="flex:0; align-self:flex-end;">
      <button class="btn btn-gold" type="submit">Add</button>
    </div>
  </form>
</div>

<div class="card">
  <table>
    <thead><tr><th>Component</th><th>Max Score</th><th>Group</th><th>Actions</th></tr></thead>
    <tbody>
    <% components.forEach(c => { %>
      <tr>
        <td><input type="text" name="name" form="edit-<%= c.id %>" value="<%= c.name %>" /></td>
        <td><input type="number" step="0.5" min="1" name="max_score" form="edit-<%= c.id %>" value="<%= c.max_score %>" /></td>
        <td><input type="text" name="group_name" form="edit-<%= c.id %>" value="<%= c.group_name || '' %>" placeholder="—" style="width:90px;" /></td>
        <td>
          <button class="btn btn-sm btn-outline" type="submit" form="edit-<%= c.id %>">Save</button>
          <form id="edit-<%= c.id %>" method="POST" action="/setup/components/<%= c.id %>"></form>
          <form method="POST" action="/setup/components/<%= c.id %>?_method=DELETE" style="display:inline" onsubmit="return confirm('Delete this component? This affects all subjects.')">
            <button class="btn btn-sm btn-danger" type="submit">Delete</button>
          </form>
        </td>
      </tr>
    <% }) %>
    </tbody>
  </table>
</div>

<div class="card">
  <h3>Weight Groups <span class="muted" style="font-weight:400; font-size:0.85rem;">(optional)</span></h3>
  <p class="muted">
    If you want groups of components to count for a fixed percentage regardless of their raw max scores — e.g. all CA components together count for 40%, Exam for 60% — set that up here.
    Assign each component to a group above (using the same group name), then set that group's weight below.
    <strong>Leave this empty to keep the simple behaviour</strong> where every component's max score is added up directly (which is how things work today).
  </p>
  <% if (weightGroups.length > 0 && weightTotal !== 100) { %>
    <div class="error-msg">Your weight groups currently add up to <strong><%= weightTotal %>%</strong>, not 100%. Consider adjusting so subject totals land cleanly out of 100.</div>
  <% } %>
  <form method="POST" action="/setup/weight-groups">
    <table id="weights-table">
      <thead><tr><th>Group Name</th><th>Weight %</th><th></th></tr></thead>
      <tbody>
      <% weightGroups.forEach(g => { %>
        <tr>
          <td><input type="text" name="group_name" value="<%= g.group_name %>" required /></td>
          <td><input type="number" step="0.5" name="weight_percent" value="<%= g.weight_percent %>" required /></td>
          <td><button type="button" class="btn btn-sm btn-danger" onclick="this.closest('tr').remove()">Remove</button></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
    <button type="button" class="btn btn-sm btn-outline" style="margin-top:0.6rem;" onclick="addWeightRow()">+ Add Group</button>
    <div style="margin-top:1rem;">
      <button class="btn btn-gold" type="submit">Save Weight Groups</button>
    </div>
  </form>
</div>

<script>
  function addWeightRow() {
    const tbody = document.querySelector('#weights-table tbody');
    const tr = document.createElement('tr');
    tr.innerHTML = `
      <td><input type="text" name="group_name" required /></td>
      <td><input type="number" step="0.5" name="weight_percent" required /></td>
      <td><button type="button" class="btn btn-sm btn-danger" onclick="this.closest('tr').remove()">Remove</button></td>
    `;
    tbody.appendChild(tr);
  }
</script>
