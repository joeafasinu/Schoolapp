<div class="toolbar"><h2>Grading Scale &amp; Comment Bank</h2></div>
<p class="muted">Define your school's own grade boundaries (e.g. A = 70 and above) and a bank of reusable comments teachers can quick-pick from when grading a student in that band.</p>

<% if (error) { %><div class="error-msg"><%= error %></div><% } %>
<% if (usingDefaults) { %>
  <div class="success-msg">You haven't set a custom scale yet, so the standard A–F scale below is being used. Edit and save it to make it your own — nothing changes until you do.</div>
<% } %>

<div class="card">
  <h3>Grade Bands</h3>
  <form method="POST" action="/setup/grading-scale">
    <table id="bands-table">
      <thead><tr><th>Grade</th><th>Minimum Score</th><th>Remark</th><th></th></tr></thead>
      <tbody>
      <% bands.forEach(b => { %>
        <tr>
          <td><input type="text" name="grade" value="<%= b.grade %>" style="width:70px;" required /></td>
          <td><input type="number" step="0.1" name="min_score" value="<%= b.min %>" style="width:90px;" required /></td>
          <td><input type="text" name="remark" value="<%= b.remark || '' %>" placeholder="e.g. Excellent" /></td>
          <td><button type="button" class="btn btn-sm btn-danger" onclick="this.closest('tr').remove()">Remove</button></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
    <button type="button" class="btn btn-sm btn-outline" style="margin-top:0.6rem;" onclick="addBandRow()">+ Add Band</button>
    <div style="margin-top:1rem;">
      <button class="btn btn-gold" type="submit">Save Grading Scale</button>
    </div>
  </form>
</div>

<div class="card">
  <h3>Comment Bank</h3>
  <p class="muted">Add a few ready-made comments for each grade. Teachers see these as quick-pick buttons when writing report card comments.</p>
  <form method="POST" action="/setup/comment-bank" class="form-row">
    <div class="field" style="flex:0 0 100px;">
      <label>Grade</label>
      <input type="text" name="grade" placeholder="A" required />
    </div>
    <div class="field">
      <label>Comment</label>
      <input type="text" name="comment_text" placeholder="e.g. An outstanding result this term. Keep it up!" required />
    </div>
    <div class="field" style="flex:0; align-self:flex-end;">
      <button class="btn btn-gold" type="submit">Add</button>
    </div>
  </form>

  <table style="margin-top:1rem;">
    <thead><tr><th>Grade</th><th>Comment</th><th></th></tr></thead>
    <tbody>
    <% commentBank.forEach(c => { %>
      <tr>
        <td><%= c.grade %></td>
        <td><%= c.comment_text %></td>
        <td>
          <form method="POST" action="/setup/comment-bank/<%= c.id %>?_method=DELETE" style="display:inline" onsubmit="return confirm('Delete this comment?')">
            <button class="btn btn-sm btn-danger" type="submit">Delete</button>
          </form>
        </td>
      </tr>
    <% }) %>
    <% if (commentBank.length === 0) { %><tr><td colspan="3" class="muted">No comments added yet.</td></tr><% } %>
    </tbody>
  </table>
</div>

<script>
  function addBandRow() {
    const tbody = document.querySelector('#bands-table tbody');
    const tr = document.createElement('tr');
    tr.innerHTML = `
      <td><input type="text" name="grade" style="width:70px;" required /></td>
      <td><input type="number" step="0.1" name="min_score" style="width:90px;" required /></td>
      <td><input type="text" name="remark" placeholder="e.g. Excellent" /></td>
      <td><button type="button" class="btn btn-sm btn-danger" onclick="this.closest('tr').remove()">Remove</button></td>
    `;
    tbody.appendChild(tr);
  }
</script>
